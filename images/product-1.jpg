 <a href="" target="_blank" class="header__banner"> <noscript><img src="" /></noscript><img class="lazyload" src='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20%20%22%3E%3C/svg%3E' data-src="" /> </a> --> <script>jQuery(function($){
    $.fn.isInViewport = function () {
        let elementTop = $(this).offset().top;
        let elementBottom = elementTop + $(this).outerHeight();

        let viewportTop = $(window).scrollTop();
        let viewportBottom = viewportTop + $(window).height();

        return elementBottom > viewportTop && elementTop < viewportBottom;
    };

    var canBeLoaded = true,
        bottomBufferZone = 5000,
        ppp = 1,
        pageNumber = 1,
        dataPostId = 1,
        CurrentScroll = 0,
        curentId = 0,
        lastUrl = $(document).find('.main-article__infinity .postcase').first().data('post-url'),
        newTitle = $(document).find('.main-article__infinity .postcase').first().data('post-title'),
        nextState = '';


      function updateState(curentId){
        newTitle =  $(document).find('[data-post-id="'+ curentId +'"]').data('post-title');
        lastUrl = $(document).find('[data-post-id="'+ curentId +'"]').data('post-url');
        window.history.replaceState(nextState, newTitle, lastUrl);
        /*document.title = newTitle;*/
      }

      
  
    $(window).scroll(function(){
      var NextScroll = $(this).scrollTop();

      if( NextScroll > CurrentScroll ) {
        $(document).find('.main-article__infinity .postcase').each(function(index) {
          if($(this).isInViewport()) {
            curentId = $(this).data('post-id');
          }
        })
        updateState(curentId);
      }
      else {
        $(document).find('.main-article__infinity .postcase').each(function(index) {
          if($(this).offset().top > NextScroll) {
            curentId = $(this).data('post-id') - 1;
            return false;
          }
        })
        if(curentId != 0) {
          updateState(curentId);
        }
      }
      CurrentScroll = NextScroll; 

      var data = '&postCategory=' + 222 + '&pageNumber=' + pageNumber + '&ppp=' + ppp + '&action=more_post_ajax';

    });
  });</script> <div class="main-article__infinity" itemscope itemtype="http://schema.org/Article"> <!--  ====================== Микроразметка ================== --><div itemscope itemtype="https://schema.org/Product" style="visibility: hidden; height: 0px"> <span itemprop="name">Как фотографировать товары для интернет-магазина, как сделать красивые фото товаров для продажи в интернет-магазине</span> <span itemprop="description">Какими должны быть фото товаров для интернет-магазина. Как красиво фотографировать товары для интернет-магазина. Какой фон выбрать, как разместить освещение. Как обработать фотографии товаров.</span> <a itemprop="url" href="https://www.calltouch.ru/blog/kak-fotografirovat-tovary-dlya-internet-magazina-podrobnaya-instruktsiya-poleznye-sovety/">https://www.calltouch.ru/blog/kak-fotografirovat-tovary-dlya-internet-magazina-podrobnaya-instruktsiya-poleznye-sovety/</a> <picture><source data-srcset="https://www.calltouch.ru/blog/wp-content/webp-express/webp-images/uploads/2019/12/chto-vybrat-yandeks-direkt-ili-gugl-advords-1024x576.jpg.webp" type="image/webp"><noscript><img itemprop="image" src="https://www.calltouch.ru/blog/wp-content/uploads/2019/12/chto-vybrat-yandeks-direkt-ili-gugl-advords-1024x576.jpg" alt="Как фотографировать товары для интернет-магазина: подробная инструкция, полезные советы" class="webpexpress-processed"></noscript><img itemprop="image" src='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20%20%22%3E%3C/svg%3E' data-src="https://www.calltouch.ru/blog/wp-content/uploads/2019/12/chto-vybrat-yandeks-direkt-ili-gugl-advords-1024x576.jpg" alt="Как фотографировать товары для интернет-магазина: подробная инструкция, полезные советы" class="lazyload webpexpress-processed"></picture><div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating"> Средняя оценка <span itemprop="ratingValue">5.0</span> Общее количество оценок <span itemprop="reviewCount">2</span></div></di