            var subscribe_block = t_el.closest('#blog-subscribe'); 
            var fio = ct_get_val(f,'input[name="your-name"],input[name="name"],input[placeholder*="Имя"]');
            var phone = ct_get_val(f,'input[name="your-phone"],input[type="phone"],input[type="tel"]');
            var email = ct_get_val(f,'input[name="your-email"],input[name="email"],input[type="email"]');
            var comment = ct_get_val(f,'textarea[placeholder="Дополнительная информация"]');
            var ct_valid = !!phone && !!fio;
            var sub = 'Заявка с ' + location.hostname;
            if(form_id == 'modal-subscribe-form') {
                sub = 'Попап при уходе с подпиской на дайджест';
                ct_valid = !!email;
            }
            if(form_action == '/#wpcf7-f12295-o1') {
                sub = 'Подписка блог';
                ct_valid = !!email && !!fio;
            }
            if(form_action.includes('/#wpcf7-f162138-p161741-o1')) {
                sub = 'Запись на консультацию';
                ct_valid = !!email && !!fio && !!phone;
                console.log('send form data to CT');
            }
            if(form_action.includes('/#wpcf7-f3825-o2')) {
                sub = 'Отправить статью на почту';
                ct_valid = !!email && !!fio;
            }
            if(!!subscribe_block) {
                sub = 'Подписка со статьи';
                ct_valid = !!email && !!fio;
            }
            var ct_data = {            
                fio: fio,
                phoneNumber: phone,
                email: email,
                subject: sub,
                requestUrl: location.href,
                comment: comment,
                sessionId: window.call_value
            };
            var post_data = Object.keys(ct_data).reduce(function(a,k){if(!!ct_data[k]){a.push(k+'='+encodeURIComponent(ct_data[k]));}return a},[]).join('&');
            var site_id = '11673';
            var CT_URL = 'https://api.calltouch.ru/calls-service/RestAPI/requests/'+site_id+'/register/';
            
            console.log(ct_data,ct_valid);
            if (ct_valid && !window.ct_snd_flag){
                window.ct_snd_flag = 1; setTimeout(function(){ window.ct_snd_flag = 0; }, 20000);
                var request = window.ActiveXObject?new ActiveXObject("Microsoft.XMLHTTP"):new XMLHttpRequest();
                request.open("POST", CT_URL, true); request.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                request.send(post_data);
            }
        } catch (e) { console.log(e); } }
